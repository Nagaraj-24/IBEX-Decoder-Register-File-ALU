create_library_set -name ss_lib -timing {/opt/sclpdkv3/scl180/stdcell/fs120/6M1L/liberty/lib_flow_ss/tsl18fs120_scl_ss.lib}
create_rc_corner -name rc_typ -T 25
create_delay_corner -name dc_ss -library_set ss_lib -rc_corner rc_typ
create_constraint_mode -name sdc_mode -sdc_files {../synthesis/decoder_register_file.sdc}
create_analysis_view -name view_ss -constraint_mode sdc_mode -delay_corner dc_ss
set_analysis_view -setup {view_ss} -hold {view_ss}
